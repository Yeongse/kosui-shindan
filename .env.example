# サイトの絶対URL基準。canonical / OG / sitemap / JSON-LD はすべてここから組み立てる。
NEXT_PUBLIC_SITE_URL=https://kosui-shindan.com

# アフィリエイトID。未設定の場合はIDなしの通常検索URLで動作する。
# 楽天: 楽天アフィリエイトのアフィリエイトID（xxxx.xxxx.xxxx.xxxx の形式）
NEXT_PUBLIC_RAKUTEN_AFFILIATE_ID=
# Amazon: アソシエイトのトラッキングID（例: kosuishindan-22）。設定するとフッターに必須表記が出る
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=

# 楽天ウェブサービスのアプリID / アクセスキー（https://webservice.rakuten.co.jp/app/create で無料発行）。
# `npm run fetch:media` でおすすめ香水3本の商品画像・商品ページURLを引くときだけ使う。
# ビルド時には参照しない（取得結果は src/data/product-media.json にコミットする）。
# アクセスキーは2026年のAPI刷新で必須になった。旧ホスト app.rakuten.co.jp は停止済み。
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=

# Cloudflare Web Analytics のビーコントークン。未設定なら読み込まない。
NEXT_PUBLIC_CF_BEACON_TOKEN=
